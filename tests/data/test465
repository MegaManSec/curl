<?xml version="1.0" encoding="US-ASCII"?>
<testcase>
<info>
<keywords>
FTP
--max-filesize
--range
</keywords>
</info>
# Server-side
<reply>
<size>
50
</size>
<data>
%repeat[2000 x A]%
</data>
<datacheck nonewline="yes">
%repeat[50 x A]%
</datacheck>
</reply>

# Client-side
<client>
<server>
ftp
</server>
<name>
FTP download maximum filesize exceeded within a range
</name>
<command>
ftp://%HOSTIP:%FTPPORT/%TESTNUMBER --range 0-999 --max-filesize 50 --ignore-content-length
</command>
</client>

# Verify data after the test has been "shot"
<verify>
<errorcode>
63
</errorcode>
<protocol crlf="yes">
USER anonymous
PASS ftp@example.com
PWD
EPSV
TYPE I
RETR %TESTNUMBER
</protocol>
</verify>
</testcase>
