<?xml version="1.0" encoding="US-ASCII"?>
<testcase>
<info>
<keywords>
MQTT
MQTT PUBLISH
</keywords>
</info>

# Server-side
<reply>
<data>
</data>
</reply>

# Client-side
<client>
<features>
Debug
mqtt
</features>
<server>
mqtt
</server>
<name>
MQTT PUBLISH not truncated by DISCONNECT after a short send
</name>
<setenv>
CURL_SMALLSENDS=24
</setenv>
<command option="binary-trace">
mqtt://%HOSTIP:%MQTTPORT/%TESTNUMBER -d AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
</command>
</client>

# Verify data after the test has been "shot"
<verify>
# These are hexadecimal protocol dumps from the client
# Strip out the random part of the client id from the CONNECT message
# before comparison
<strippart>
s/^(.* 00044d5154540402003c000c6375726c).*/$1/
</strippart>
<protocol>
client CONNECT 18 00044d5154540402003c000c6375726c
server CONNACK 2 20020000
client PUBLISH 2e 00043232303941414141414141414141414141414141414141414141414141414141414141414141414141414141
client DISCONNECT 0 e000
</protocol>
</verify>
</testcase>
