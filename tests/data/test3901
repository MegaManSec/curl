<?xml version="1.0" encoding="US-ASCII"?>
<testcase>
<info>
<keywords>
IMAP
SASL
SASL AUTH PLAIN
SASL AUTH EXTERNAL
RFC4422
timeout
flaky
timing-dependent
</keywords>
</info>

# Server-side
<reply>
<servercmd>
AUTH PLAIN EXTERNAL
CAPA SASL-IR
REPLY AUTHENTICATE A002 OK AUTHENTICATE completed
</servercmd>
<data crlf="yes" nocheck="yes">
From: me@somewhere
To: fake@nowhere

body

--
  yours sincerely
</data>
</reply>

# Client-side
<client>
<server>
imap
</server>
<name>
IMAP does not reuse a connection when AUTH restriction gets stricter
</name>
<command>
'imap://user:secret;AUTH=PLAIN@%HOSTIP:%IMAPPORT/%TESTNUMBER/;MAILINDEX=1' --sasl-ir -o %LOGDIR/download1%TESTNUMBER -w '%{num_connects}\n' --next 'imap://user:secret;AUTH=EXTERNAL@%HOSTIP:%IMAPPORT/%TESTNUMBER/;MAILINDEX=1' --sasl-ir --max-time %FTPTIME2 -o %LOGDIR/download2%TESTNUMBER -w '%{num_connects}\n'
</command>
</client>

# Verify data after the test has been "shot"
<verify>
# The second request must not reuse the PLAIN-authenticated connection, so
# it opens a fresh one, which the test server cannot also service and the
# request times out instead of silently reusing the first connection.
<protocol crlf="yes">
A001 CAPABILITY
A002 AUTHENTICATE PLAIN %b64[%00user%00secret]b64%
A003 SELECT %TESTNUMBER
A004 FETCH 1 BODY[]
A005 LOGOUT
</protocol>
<stdout>
1
1
</stdout>
<errorcode>
28
</errorcode>
</verify>
</testcase>
