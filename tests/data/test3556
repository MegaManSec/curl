<?xml version="1.0" encoding="US-ASCII"?>
<testcase>
<info>
<keywords>
TELNET
LOW-SPEED-LIMIT
</keywords>
</info>

# Server-side
<reply>
<data crlf="headers" nocheck="yes">
HTTP/1.0 200 OK swsclose
Content-Length: 40
Connection: close

xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
</data>
<servercmd>
writedelay: 1000
</servercmd>
</reply>

# Client-side
<client>
<server>
http
</server>
<features>
telnet
!win32
</features>
<name>
TELNET receive loop honors --speed-limit and --speed-time
</name>
<stdin crlf="headers">
GET /this/for/%TESTNUMBER HTTP/1.0

</stdin>
<command option="no-output">
telnet://%HOSTIP:%HTTPPORT --speed-limit 12000 --speed-time 1
</command>
</client>

# Verify data after the test has been "shot"
<verify>
<errorcode>
28
</errorcode>
</verify>
</testcase>
