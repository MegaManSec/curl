<?xml version="1.0" encoding="US-ASCII"?>
<testcase>
<info>
<keywords>
SMTP
</keywords>
</info>

# Server-side
<reply>
</reply>

# Client-side
<client>
<server>
smtp
</server>
<name>
SMTP data with a bare LF before a line-leading dot
</name>
<file name="%LOGDIR/mail%TESTNUMBER">
PRELINE
.CRLFINJTEST%CR
</file>
<command>
smtp://%HOSTIP:%SMTPPORT/%TESTNUMBER --mail-rcpt recipient@example.com --mail-from sender@example.com -T %LOGDIR/mail%TESTNUMBER
</command>
</client>

# Verify data after the test has been "shot"
<verify>
<protocol crlf="yes">
EHLO %TESTNUMBER
MAIL FROM:%LTsender@example.com%GT
RCPT TO:%LTrecipient@example.com%GT
DATA
QUIT
</protocol>
<upload>
PRELINE
..CRLFINJTEST%CR
.%CR
</upload>
</verify>
</testcase>
