<?xml version="1.0" encoding="US-ASCII"?>
<testcase>
<info>
<keywords>
HTTP
HTTP GET
compressed
Transfer-Encoding
Content-Encoding
</keywords>
</info>

# Server-side
<reply>
<data nocheck="yes">
HTTP/1.1 200 OK
Content-Length: 6
Transfer-Encoding: gzip
Transfer-Encoding: gzip
Transfer-Encoding: gzip
Content-Encoding: gzip
Content-Encoding: gzip
Content-Encoding: gzip

-foo-
</data>
</reply>

# Client-side
<client>
<server>
http
</server>
<features>
libz
</features>
<name>
Combined Transfer- and Content-Encoding exceeding the stack limit
</name>
<command>
http://%HOSTIP:%HTTPPORT/%TESTNUMBER -sS --tr-encoding --compressed
</command>
</client>

# Verify data after the test has been "shot"
<verify>
<strippart>
s/^Accept-Encoding: [a-zA-Z, ]*/Accept-Encoding: xxx/
</strippart>
<protocol crlf="headers">
GET /%TESTNUMBER HTTP/1.1
Host: %HOSTIP:%HTTPPORT
User-Agent: curl/%VERSION
Accept: */*
TE: gzip
Accept-Encoding: xxx
Connection: TE

</protocol>

# CURLE_BAD_CONTENT_ENCODING is 61
<errorcode>
61
</errorcode>
<stderr mode="text">
curl: (61) Reject response exceeding limit of 5 content encodings
</stderr>
</verify>
</testcase>
