<?xml version="1.0" encoding="US-ASCII"?>
<testcase>
<info>
<keywords>
SMTP
EXPN
CUSTOMREQUEST
CRLF
</keywords>
</info>

# Client-side
<client>
<server>
smtp
</server>
<name>
SMTP custom command rejects a CRLF in --mail-rcpt
</name>
<stdin>
url = "smtp://%HOSTIP:%SMTPPORT/%TESTNUMBER"
mail-rcpt = "Friends\r\nNOOP"
request = "EXPN"
</stdin>
<command>
-K -
</command>
</client>

# Verify data after the test has been "shot"
<verify>
# 43 - CURLE_BAD_FUNCTION_ARGUMENT
<errorcode>
43
</errorcode>
<protocol crlf="yes">
EHLO %TESTNUMBER
QUIT
</protocol>
</verify>
</testcase>
