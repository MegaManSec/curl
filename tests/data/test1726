<?xml version="1.0" encoding="US-ASCII"?>
<testcase>
<info>
<keywords>
HTTP
HTTP GET
-w
%header_json
</keywords>
</info>

# Server-side
<reply>
<data nocheck="yes">
HTTP/1.1 200 OK
Date: Tue, 09 Nov 2010 14:49:00 GMT
Content-Type: text/html
Content-Length: 6
X-Big: %repeat[101000 x A]%
Connection: close

-foo-
</data>
</reply>

# Client-side
<client>
<features>
headers-api
</features>
<server>
http
</server>
<name>
-w header JSON output with an oversized header value stays valid JSON
</name>
<command option="no-output">
http://%HOSTIP:%HTTPPORT/%TESTNUMBER -w '%{header_json}\n' -o %LOGDIR/%TESTNUMBER.out
</command>
</client>

# Verify data after the test has been "shot"
<verify>
<protocol crlf="headers">
GET /%TESTNUMBER HTTP/1.1
Host: %HOSTIP:%HTTPPORT
User-Agent: curl/%VERSION
Accept: */*

</protocol>
<stdout mode="text">
{"date":["Tue, 09 Nov 2010 14:49:00 GMT"],
"content-type":["text/html"],
"content-length":["6"],
"x-big":["%repeat[99996 x A]%..."],
"connection":["close"]
}
</stdout>
</verify>
</testcase>
