<?xml version="1.0" encoding="US-ASCII"?>
<testcase>
<info>
<keywords>
POP3
Clear Text
RETR
</keywords>
</info>

# Server-side
<reply>
<servercmd>
RETRNOEOB
</servercmd>
<data crlf="yes" nocheck="yes">
From: me@somewhere
To: fake@nowhere

body that never
</data>
</reply>

# Client-side
<client>
<server>
pop3
</server>
<name>
POP3 RETR with premature end of connection before EOB
</name>
<command>
pop3://%HOSTIP:%POP3PORT/%TESTNUMBER -u user:secret
</command>
</client>

# Verify data after the test has been "shot"
<verify>
<errorcode>
18
</errorcode>
<protocol crlf="yes">
CAPA
USER user
PASS secret
RETR %TESTNUMBER
</protocol>
</verify>
</testcase>
