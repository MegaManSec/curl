<?xml version="1.0" encoding="US-ASCII"?>
<testcase>
<info>
<keywords>
HTTP
HTTP GET
HTTP NTLM auth
NTLM
</keywords>
</info>

<!-- Server-side -->
<reply>

<!-- no <data> in this test since we have NTLM from the start

This is supposed to be returned every time the server gets a
Authorization: NTLM type-1 line passed-in from the client, without ever
sending back a type-2 challenge -->

<data1001 crlf="headers" nocheck="yes">
HTTP/1.1 401 Please retry
Server: Microsoft-IIS/5.0
Content-Type: text/html; charset=iso-8859-1
Content-Length: 0
WWW-Authenticate: NTLM

</data1001>

<data crlf="headers" nocheck="yes">
HTTP/1.1 200 Things are fine in server land swsclose
Server: Microsoft-IIS/5.0
Content-Type: text/html; charset=iso-8859-1
Content-Length: 32

Finally, this is the real page!
</data>

</reply>

# Client-side
<client>
<features>
NTLM
SSL
!SSPI
</features>
<server>
http
</server>
<name>
HTTP NTLM bare re-challenge does not waste the connection
</name>
<command option="no-include">
http://%HOSTIP:%HTTPPORT/%TESTNUMBER -u testuser:testpass --ntlm -w "%{num_connects}\n"
--next
http://%HOSTIP:%HTTPPORT/%TESTNUMBER -w "%{num_connects}\n"
</command>
</client>

# Verify data after the test has been "shot"
<verify>
<protocol crlf="headers">
GET /%TESTNUMBER HTTP/1.1
Host: %HOSTIP:%HTTPPORT
Authorization: NTLM %b64[NTLMSSP%00%01%00%00%00%06%82%08%00%00%00%00%00%00%00%00%00%00%00%00%00%00%00%00%00]b64%
User-Agent: curl/%VERSION
Accept: */*

GET /%TESTNUMBER HTTP/1.1
Host: %HOSTIP:%HTTPPORT
Authorization: NTLM %b64[NTLMSSP%00%01%00%00%00%06%82%08%00%00%00%00%00%00%00%00%00%00%00%00%00%00%00%00%00]b64%
User-Agent: curl/%VERSION
Accept: */*

GET /%TESTNUMBER HTTP/1.1
Host: %HOSTIP:%HTTPPORT
User-Agent: curl/%VERSION
Accept: */*

</protocol>

<stdout>
1
Finally, this is the real page!
0
</stdout>
</verify>
</testcase>
