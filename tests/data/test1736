<?xml version="1.0" encoding="US-ASCII"?>
<testcase>
<info>
<keywords>
HTTP
HTTP GET
HTTP Digest auth
--request-target
</keywords>
</info>

# Server-side
<reply>
<data crlf="headers">
HTTP/1.1 401 Authorization Required swsclose
WWW-Authenticate: Digest realm="weirdorealm", nonce="12345"

</data>

<data1000 crlf="headers">
HTTP/1.1 200 OK swsclose
Server: no
Content-Length: 15

Nice auth sir!
</data1000>

<datacheck crlf="headers">
HTTP/1.1 401 Authorization Required swsclose
WWW-Authenticate: Digest realm="weirdorealm", nonce="12345"

HTTP/1.1 200 OK swsclose
Server: no
Content-Length: 15

Nice auth sir!
</datacheck>
</reply>

# Client-side
<client>
<server>
http
</server>
<features>
!SSPI
crypto
digest
</features>
<name>
HTTP Digest auth signs the --request-target value, not the URL path
</name>
<command>
http://%HOSTIP:%HTTPPORT/%TESTNUMBER --request-target '/other-target' --digest --user digest:a-lot
</command>
</client>

# Verify data after the test has been "shot"
<verify>
<protocol crlf="headers">
GET /other-target HTTP/1.1
Host: %HOSTIP:%HTTPPORT
User-Agent: curl/%VERSION
Accept: */*

GET /other-target HTTP/1.1
Host: %HOSTIP:%HTTPPORT
Authorization: Digest username="digest", realm="weirdorealm", nonce="12345", uri="/other-target", response="06b9dbb64053a1b0525f4b22f6586321"
User-Agent: curl/%VERSION
Accept: */*

</protocol>
</verify>
</testcase>
