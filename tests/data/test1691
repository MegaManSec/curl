<?xml version="1.0" encoding="US-ASCII"?>
<testcase>
<info>
<keywords>
TFTP
TFTP WRQ
</keywords>
</info>

# Server-side
<reply>
<servercmd>
wrq_send_data
</servercmd>
</reply>

# Client-side
<client>
<server>
tftp
</server>
<name>
TFTP upload where server replies with DATA instead of ACK
</name>
<command>
-T %LOGDIR/test%TESTNUMBER.txt tftp://%HOSTIP:%TFTPPORT//
</command>
<file name="%LOGDIR/test%TESTNUMBER.txt">
unexpected data must not reach the write callback
</file>
</client>

# Verify pseudo protocol after the test has been "shot"
<verify>
<strip>
^timeout = [5-6]$
</strip>
<protocol>
opcode = 2
mode = octet
tsize = 50
blksize = 512
filename = /test%TESTNUMBER.txt
</protocol>
# 71 = CURLE_TFTP_ILLEGAL
<errorcode>
71
</errorcode>
</verify>
</testcase>
