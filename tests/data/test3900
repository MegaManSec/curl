<?xml version="1.0" encoding="US-ASCII"?>
<testcase>
<info>
<keywords>
SMTP
SASL
SASL AUTH PLAIN
SASL AUTH EXTERNAL
RFC4422
RFC4954
timeout
flaky
timing-dependent
</keywords>
</info>

# Server-side
<reply>
<servercmd>
AUTH PLAIN EXTERNAL
REPLY AUTH 235 Authenticated
</servercmd>
</reply>

# Client-side
<client>
<server>
smtp
</server>
<name>
SMTP does not reuse a connection when AUTH restriction gets stricter
</name>
<command>
'smtp://user:secret;AUTH=PLAIN@%HOSTIP:%SMTPPORT/%TESTNUMBER0001' --mail-rcpt recipient@example.com --mail-from sender@example.com --sasl-ir -T %LOGDIR/test%TESTNUMBER.txt -w '%{num_connects}\n' --next 'smtp://user:secret;AUTH=EXTERNAL@%HOSTIP:%SMTPPORT/%TESTNUMBER0002' --mail-rcpt recipient@example.com --mail-from sender@example.com --sasl-ir --max-time %FTPTIME2 -T %LOGDIR/test%TESTNUMBER.txt -w '%{num_connects}\n'
</command>
<file name="%LOGDIR/test%TESTNUMBER.txt">
mail body
</file>
</client>

# Verify data after the test has been "shot"
<verify>
# The second request must not reuse the PLAIN-authenticated connection, so
# it opens a fresh one, which the test server cannot also service and the
# request times out instead of silently reusing the first connection.
<protocol crlf="yes">
EHLO %TESTNUMBER0001
AUTH PLAIN %b64[%00user%00secret]b64%
MAIL FROM:%LTsender@example.com%GT
RCPT TO:%LTrecipient@example.com%GT
DATA
QUIT
</protocol>
<stdout>
1
1
</stdout>
<errorcode>
28
</errorcode>
</verify>
</testcase>
